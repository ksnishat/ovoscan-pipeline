FROM python:3.10-slim

# 1. Install system libraries (Required for OpenCV & PyTorch)
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. INSTALL PYTORCH (Universal Version)
# We use a high timeout (1000s) to prevent BrokenPipeError on large downloads.
# We do NOT use --index-url .../cpu, so this installs GPU support by default.
RUN pip install --no-cache-dir --default-timeout=1000 torch torchvision torchaudio ultralytics

# 3. Install the remaining dependencies from the uv lock.
# torch and ultralytics are installed above from the default index (GPU build),
# so they are filtered out of the exported set to avoid pip replacing them with
# the CPU wheels that [tool.uv.sources] pins.
COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv \
    && uv export --frozen --no-emit-project --format requirements-txt -o /tmp/req.txt \
    && grep -vE "^(torch|torchvision|torchaudio|ultralytics)" /tmp/req.txt > /tmp/req_clean.txt \
    && pip install --no-cache-dir --default-timeout=1000 -r /tmp/req_clean.txt

# 4. Copy Code
COPY src/ src/
COPY serving/ serving/
COPY data/knowledge_base/ data/knowledge_base/

EXPOSE 8001

CMD ["uvicorn", "src.app:app", "--host", "0.0.0.0", "--port", "8001"]
